# Server
PORT=3000
# 必填：用强随机字符串替换（例如 openssl rand -hex 32）。
# 若缺失或为默认占位值，服务会生成临时随机密钥（重启后登录失效）。
JWT_SECRET=please-replace-with-a-long-random-string

# DeepSeek
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 邮件服务（忘记密码/找回验证码）。
# 未配置时进入开发模式：验证码不真正发送，而是打印到服务端日志并随接口响应返回。
# SMTP_HOST= smtp.qq.com
# SMTP_PORT= 465
# SMTP_USER= your-mail@qq.com
# SMTP_PASS= your-smtp-auth-code
# MAIL_FROM= your-mail@qq.com
